# ===========================================================================
# ローカル開発用の設定例 / Local development
#
#   cp .env.example .env
#
# docker compose up -d でPostgreSQLとメール確認用のMailpitが起動します。
# この設定のままで、AIサービスやAWSのアカウントがなくても動作します。
# ===========================================================================

NODE_ENV=development

# --- データベース -----------------------------------------------------------
# docker compose で起動するPostgreSQLに接続します。
DATABASE_URL="postgresql://skillsheet:skillsheet@localhost:5432/skillsheet?schema=public"

# --- アプリケーション -------------------------------------------------------
APP_URL="http://localhost:3000"
APP_NAME="スキルシート管理システム"
COMPANY_NAME="モラブ阪神工業株式会社"

# --- 認証 -------------------------------------------------------------------
# 32文字以上のランダムな文字列。 openssl rand -base64 48 で生成できます。
AUTH_SECRET="CHANGE_ME_local_development_secret_at_least_32_chars"
# ログインを許可するメールドメイン（カンマ区切り）。ローカルでは自由に設定できます。
AUTH_ALLOWED_EMAIL_DOMAINS="morabu.com,example.com"
AUTH_LINK_TTL_MINUTES=15
AUTH_SESSION_TTL_DAYS=30

# 初回セットアップ時に作成する管理者。db:seed のときだけ使われます。
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_NAME="管理者"

# 共有のデモアカウント（閲覧のみ）。不要なら空のままにしてください。
DEMO_ACCOUNT_EMAIL="demo@example.com"
DEMO_ACCOUNT_PASSWORD="demo-password"
NEXT_PUBLIC_DEMO_ACCOUNT_ENABLED=true

# --- メール送信 -------------------------------------------------------------
# console = ログインリンクをサーバのログに出力します（メールサーバ不要）。
# smtp    = docker compose の Mailpit を使う場合は下のコメントを外してください。
MAIL_TRANSPORT=console
MAIL_FROM="skillsheet@example.local"
# MAIL_TRANSPORT=smtp
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=false

# --- ファイル保存 -----------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

# --- AIサービス -------------------------------------------------------------
# mock = AI未接続。パイプライン全体をAIなしで動かせます（仮の文章が入ります）。
AI_PROVIDER=mock
AI_MODEL=mock-model
AI_TEMPERATURE=0
AI_MAX_TOKENS=1500

# --- PDF --------------------------------------------------------------------
# 未設定の場合は playwright がインストールしたChromiumを探します。
# CHROMIUM_PATH=/usr/bin/chromium
PDF_MAX_CONCURRENCY=1
PDF_FOOTER_SHOW_TIME=false
