# ===========================================================================
# 本番（AWS）用の設定例 / Production on AWS
#
# 実際の値は AWS Systems Manager パラメータストア（SecureString）に保存し、
# 起動時に環境変数として読み込んでください。このファイルはひな形です。
# 値を引用符で囲まないこと — Docker の env_file は引用符も値の一部として読む。
# 詳細は docs/AWS-REQUIREMENTS.md を参照してください。
# ===========================================================================

NODE_ENV=production
PORT=3000

# --- データベース -----------------------------------------------------------
# 当面は同一EC2インスタンス上のPostgreSQL（docker-compose.prod.yml の db サービス）。
# ホスト名は 127.0.0.1 ではなく db — appコンテナの中の 127.0.0.1 はapp自身を指す。
# パスワードは .env の POSTGRES_PASSWORD と同じ値（URLに入るので openssl rand -hex 24 で作る）。
# 将来RDSへ移行する際は、この1行のホスト名を差し替えるだけで移行できます（仕様書5.7節）。
DATABASE_URL=postgresql://skillsheet:__PASSWORD__@db:5432/skillsheet?schema=public

# --- アプリケーション -------------------------------------------------------
APP_URL=https://dx.morabu.com
APP_NAME=スキルシート管理システム
COMPANY_NAME=モラブ阪神工業株式会社

# --- 認証 -------------------------------------------------------------------
# openssl rand -base64 48 で生成し、パラメータストアに保存してください。
AUTH_SECRET=__SET_FROM_PARAMETER_STORE__
AUTH_ALLOWED_EMAIL_DOMAINS=morabu.com
AUTH_LINK_TTL_MINUTES=15
AUTH_SESSION_TTL_DAYS=30

# 試用期間中のみ有効にし、終了後は空にしてアカウントを削除してください。
DEMO_ACCOUNT_EMAIL=
DEMO_ACCOUNT_PASSWORD=
NEXT_PUBLIC_DEMO_ACCOUNT_ENABLED=false

# --- メール送信（Amazon SES）------------------------------------------------
MAIL_TRANSPORT=smtp
MAIL_FROM=skillsheet@morabu.com
SMTP_HOST=email-smtp.ap-northeast-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=__SES_SMTP_USERNAME__
SMTP_PASSWORD=__SES_SMTP_PASSWORD__

# --- ファイル保存（当面はローカルディスク、S3は見送り）----------------------
# 2026-09-24: S3バケットは今回作らないことにした。写真・PDF・DBバックアップは
# すべてEC2インスタンス自身のEBSボリュームに保存する(docs/AWS-REQUIREMENTS.md
# §2a参照)。インスタンス障害時にオフサイトの控えが無いという代償があるため、
# 暫定措置と理解した上での選択。docker-compose.prod.ymlでこのパス
# (コンテナ内 /app/storage)をホストの /var/lib/skillsheet/storage に
# マウントしてあるので、再デプロイ(コンテナ再ビルド)しても消えない。
# 後日S3に切り替える場合は STORAGE_DRIVER=s3 と S3_BUCKET/S3_REGION を
# 設定するだけでよく、アプリ側の変更は不要(src/lib/storage.ts参照)。
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
# S3を使う場合(将来):
# STORAGE_DRIVER=s3
# S3_BUCKET=morabu-dx-skillsheet
# S3_REGION=ap-northeast-1
# EC2のインスタンスロールを使う場合はアクセスキーを設定しないでください。
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- AIサービス（Google AI / Gemini API）------------------------------------
# 2026-09-24: Bedrockから変更。この構成はAWSの外(Google)にデータを送信するため、
# 実データで使う前に佐野様からの書面での了承が必須です(仕様書3章・13章、
# docs/AWS-REQUIREMENTS.md §4参照)。了承が済むまでは mock のままにしてください。
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=__GEMINI_API_KEY__
AI_MODEL=__GEMINI_MODEL_NAME__
AI_TEMPERATURE=0
AI_MAX_TOKENS=1500
AI_TIMEOUT_MS=60000

# --- PDF --------------------------------------------------------------------
CHROMIUM_PATH=/usr/bin/chromium
PDF_MAX_CONCURRENCY=1
PDF_FOOTER_SHOW_TIME=false
